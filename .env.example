# === Reddit (asyncpraw OAuth) ===
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=gameee/0.1 by u_yourname
REDDIT_USERNAME=
REDDIT_PASSWORD=

# === Twitter (twscrape) ===
# Accounts DB path (twscrape CLI: `twscrape add_accounts ...`)
TWSCRAPE_DB=./.data/twscrape.db

# === Threads (Playwright session) ===
THREADS_SESSION_PATH=./.data/threads_session.json

# === LLM ===
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# === TTS ===
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-sa.json
# Voice default (Chirp 3 HD). Override via config/voices.yaml
TTS_DEFAULT_VOICE=ru-RU-Chirp3-HD-Kore

# === Images ===
PEXELS_API_KEY=
PIXABAY_API_KEY=
REPLICATE_API_TOKEN=
# Playwright auth state paths
CHATGPT_SESSION_PATH=./.data/chatgpt_session.json
IMAGEFX_SESSION_PATH=./.data/imagefx_session.json

# === Publish ===
YOUTUBE_CLIENT_SECRET=./secrets/client_secret.json
YOUTUBE_TOKEN=./secrets/youtube_token.pickle
META_ACCESS_TOKEN=
META_IG_USER_ID=

# === Runtime ===
GAMEEE_DB=./.data/gameee.db
GAMEEE_RUNS=./runs
GAMEEE_LOG_LEVEL=INFO
